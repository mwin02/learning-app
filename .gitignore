# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# backup files
/backups
*.bak
*.backup
*.orig
*~

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# claude code local files (CLAUDE.md, shared skills/rules/agents/settings are
# tracked; the rest is local — settings.local.json stays personal)
.claude/*
!.claude/skills/
!.claude/rules/
!.claude/agents/
# settings.json is shared because it carries the .env* read denies that back
# .claude/rules/env-files.md — advisory in a rule, enforced only from here.
!.claude/settings.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local DB content snapshots (2.5h reset script)
backups/

# local audit working docs (deliberately untracked)
/docs/audits/
